{
  "name": "music-prompt-studio",
  "version": "1.3.1",
  "description": "Music Prompt Studio — tysiące promptów dla narzędzi AI do tworzenia muzyki (Suno, Udio, Mureka, Stable Audio, ElevenLabs). Baza, generator, ulubione, tagowanie, eksport, własne szablony. Silniki: Gemini API + lokalny Ollama.",
  "author": "Marek Zettel (Cyfrowy Przyjaciel)",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "icons": "node scripts/make-icons.mjs",
    "postinstall": "electron-builder install-app-deps",
    "dist": "node scripts/build-installer.mjs",
    "dist:nsis": "npm run build && electron-builder --win nsis",
    "dist:dir": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "@google/genai": "^0.14.0",
    "better-sqlite3": "^11.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "zustand": "^5.0.2"
  }
}
